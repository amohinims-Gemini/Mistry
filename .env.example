# Copy this file to .env and fill in your own values.
# .env is gitignored - your real credentials never get committed.
#
# Get these from your OANDA account: https://www.oanda.com/demo-account/
# (log in -> "Manage API Access" to generate a personal access token)

# Your OANDA API access token (demo/practice account is fine - and
# recommended, since this project only ever reads price data anyway)
OANDA_API_TOKEN=your_oanda_api_token_here

# Your OANDA account ID, format like 101-004-12345678-001
OANDA_ACCOUNT_ID=your_oanda_account_id_here
